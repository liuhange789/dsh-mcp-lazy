{
  "name": "@liuhange/dsh-mcp-lazy",
  "version": "1.0.1",
  "description": "MCP 工具的按需加载插件 — 默认只保留核心 MCP 工具，其余定义从本次会话的工具列表中移除，模型需要时用 lazy_load_tool 现场装载",
  "author": "liuhange789",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/dsh-mcp-lazy.git"
  },
  "homepage": "https://github.com/liuhange789/dsh-mcp-lazy",
  "bugs": {
    "url": "https://github.com/liuhange789/dsh-mcp-lazy/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./host/dist/index.js",
  "types": "./host/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./host/dist/index.d.ts",
      "default": "./host/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "host/dist",
    "cordis.patch.yml",
    "README.md",
    "VERIFICATION.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "workspaces": [
    "host"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts --isolate=false",
    "typecheck": "npm run typecheck --workspaces",
    "verify:real": "node scripts/verify-real-runtime.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "mcp",
    "model-context-protocol",
    "lazy-loading",
    "on-demand",
    "prompt-cache",
    "context-optimization",
    "tools",
    "plugin",
    "typescript",
    "nodejs"
  ]
}
